.env.*
!.env.example
**/local.settings.json
*.publishsettings
*.pfx
*.pem
*.key

# Python
__pycache__/
*.pyc
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
coverage.xml
htmlcov/
